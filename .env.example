# Banco Postgres (Supabase). Local: session pooler (5432). Vercel: transaction pooler (6543).
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Protege a rota /api/cron/daily (resumo diário por push)
CRON_SECRET=""

# Supabase Storage (fotos/assinaturas) — bucket privado "uploads"
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
